# Copiar a `.env.admin` SOLO en el PC de quien desarrolla. NO se versiona y
# NO va a Netlify: la app no la necesita ni debe tenerla.
#
# La usa únicamente `npm run alta-personal` para crear cuentas del personal.
# Supabase → Project Settings → API Keys → Secret keys (`sb_secret_...`).
#
# ⚠️ Se salta RLS entera. Si se filtra, se revoca en esa misma pantalla y se
#    crea otra; las cuentas ya creadas no se ven afectadas.

SUPABASE_SECRET_KEY=sb_secret_...
